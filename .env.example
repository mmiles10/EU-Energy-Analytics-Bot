# Copy to .env and fill in real values. Never commit .env or paste secrets into tracked files.
ENTSOE_API_KEY=your_entsoe_api_key_here
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional bot runtime defaults
PRIMARY_COUNTRY=AT
FROM_COUNTRY=CH
TO_COUNTRY=DE_LU
CHECK_INTERVAL_SEC=300
